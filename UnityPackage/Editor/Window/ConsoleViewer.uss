/* Layout and controls come from Unity's own editor theme (Toolbar, ListView, ScrollView), so the
   window follows the Dark and Light skins. Only the message colours differ per skin, through the
   console-viewer--light class the window sets on the Light skin. */

.console-viewer {
    flex-grow: 1;
}

.console-viewer__toolbar,
.console-viewer__details-toolbar {
    flex-shrink: 0;
}

.console-viewer__toolbar-spacer {
    flex-grow: 1;
}

.console-viewer__instance-menu {
    min-width: 140px;
    max-width: 280px;
}

.console-viewer__message-list {
    flex-grow: 1;
    min-height: 60px;
}

.console-viewer__search {
    width: 180px;
    min-width: 80px;
    flex-shrink: 1;
}

.console-viewer__type-toggle {
    min-width: 44px;
}

.console-viewer__type-icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-right: 2px;
    background-image: url("project://database/Packages/com.reromanlee.consolecontainer/Editor/Textures/info.png?fileID=2800000&guid=82f57434a9e7fca479ac49d21bc55e98&type=3#info");
}

.console-viewer__type-icon--warning {
    background-image: url("project://database/Packages/com.reromanlee.consolecontainer/Editor/Textures/warning.png?fileID=2800000&guid=8d98323fa783d0a47a1498bcc7fb5a98&type=3#warning");
}

.console-viewer__type-icon--error {
    background-image: url("project://database/Packages/com.reromanlee.consolecontainer/Editor/Textures/error.png?fileID=2800000&guid=5ac7acc60d94c444d8561bdf4d6004ef&type=3#error");
}

/* Message rows */

.message-row {
    flex-direction: row;
    align-items: center;
    height: 100%;
    padding-left: 3px;
    padding-right: 3px;
}

.message-row__icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-right: 4px;
    background-image: url("project://database/Packages/com.reromanlee.consolecontainer/Editor/Textures/info.png?fileID=2800000&guid=82f57434a9e7fca479ac49d21bc55e98&type=3#info");
}

.message-row--warning > .message-row__icon {
    background-image: url("project://database/Packages/com.reromanlee.consolecontainer/Editor/Textures/warning.png?fileID=2800000&guid=8d98323fa783d0a47a1498bcc7fb5a98&type=3#warning");
}

.message-row--error > .message-row__icon {
    background-image: url("project://database/Packages/com.reromanlee.consolecontainer/Editor/Textures/error.png?fileID=2800000&guid=5ac7acc60d94c444d8561bdf4d6004ef&type=3#error");
}

.message-row__time,
.message-row__text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.message-row__time {
    flex-shrink: 0;
    margin-right: 6px;
    opacity: 0.75;
}

.message-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.message-row--warning > .message-row__text {
    color: rgb(254, 193, 7);
}

.message-row--error > .message-row__text {
    color: rgb(255, 110, 63);
}

.console-viewer--light .message-row--warning > .message-row__text {
    color: rgb(138, 96, 0);
}

.console-viewer--light .message-row--error > .message-row__text {
    color: rgb(198, 40, 40);
}

/* Details pane */

.console-viewer__details {
    flex-grow: 1;
    min-height: 80px;
}

.console-viewer__details-instance {
    -unity-text-align: middle-left;
    padding-left: 6px;
    -unity-font-style: bold;
}

.console-viewer__callstack {
    min-width: 120px;
}

.console-viewer__details-scroll {
    flex-grow: 1;
    min-width: 150px;
}

.console-viewer__details-label {
    white-space: normal;
    padding: 4px;
    -unity-text-align: upper-left;
}

.callstack-button {
    margin: 2px 3px 0 3px;
    padding-left: 8px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Fallback shown when the window's layout asset cannot be loaded. */

.console-viewer__load-error {
    margin: 8px;
}
