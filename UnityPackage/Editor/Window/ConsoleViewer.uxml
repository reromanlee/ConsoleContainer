<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/com.reromanlee.consolecontainer/Editor/Window/ConsoleViewer.uss?fileID=7433441132597879392&amp;guid=7684bd65830b8614186062a2133841db&amp;type=3#ConsoleViewer"/>
    <ui:VisualElement name="console-viewer" class="console-viewer">
        <uie:Toolbar name="toolbar" class="console-viewer__toolbar">
            <uie:ToolbarButton name="clear-button" text="Clear" tooltip="Clear the selected instance, or every instance while All Instances is selected."/>
            <uie:ToolbarToggle name="clear-on-play-toggle" text="Clear on Play" tooltip="Clear every instance when entering play mode. Shared by all Console Viewer windows."/>
            <uie:ToolbarMenu name="instance-menu" class="console-viewer__instance-menu" tooltip="Instance to show."/>
            <uie:ToolbarSpacer class="console-viewer__toolbar-spacer"/>
            <uie:ToolbarSearchField name="search-field" class="console-viewer__search" tooltip="Show only messages whose source or content contains this text (case-insensitive)."/>
            <uie:ToolbarToggle name="text-toggle" class="console-viewer__type-toggle" value="true" tooltip="Show Text messages."/>
            <uie:ToolbarToggle name="warning-toggle" class="console-viewer__type-toggle" value="true" tooltip="Show Warning messages."/>
            <uie:ToolbarToggle name="error-toggle" class="console-viewer__type-toggle" value="true" tooltip="Show Error messages."/>
        </uie:Toolbar>
        <ui:TwoPaneSplitView name="main-split-view" orientation="Vertical" fixed-pane-index="1" fixed-pane-initial-dimension="150">
            <ui:ListView name="message-list" class="console-viewer__message-list" virtualization-method="FixedHeight" fixed-item-height="18" selection-type="Single" show-alternating-row-backgrounds="ContentOnly"/>
            <ui:VisualElement name="details-pane" class="console-viewer__details">
                <uie:Toolbar class="console-viewer__details-toolbar">
                    <ui:Label name="details-instance-label" class="console-viewer__details-instance"/>
                    <uie:ToolbarSpacer class="console-viewer__toolbar-spacer"/>
                    <uie:ToolbarButton name="copy-button" text="Copy" tooltip="Copy the selected message and its full call stack (Ctrl+C in the list)."/>
                </uie:Toolbar>
                <ui:TwoPaneSplitView name="details-split-view" orientation="Horizontal" fixed-pane-index="0" fixed-pane-initial-dimension="250">
                    <ui:ScrollView name="callstack-pane" class="console-viewer__callstack"/>
                    <ui:ScrollView class="console-viewer__details-scroll">
                        <ui:Label name="details-label" class="console-viewer__details-label"/>
                    </ui:ScrollView>
                </ui:TwoPaneSplitView>
            </ui:VisualElement>
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
